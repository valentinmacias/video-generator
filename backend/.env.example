# Runway ML (primary video provider — Gen-4 Turbo + Gen-4.5)
RUNWAYML_API_SECRET=rw_xxxxxxxxxxxxxxxxxxxxxxxx

# Runway API base URL
# Sandbox/dev (free tier, no credits deducted): https://api.dev.runwayml.com
# Production (real credits deducted):           https://api.runwayml.com
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com

# Google AI (Veo fallback + Gemini prompt enhancement + Imagen)
GOOGLE_API_KEY=your_google_api_key_here
VEO_MODEL=veo-3.1-generate-preview
GEMINI_MODEL=gemini-1.5-flash

# Gemini Veo dedicated key (optional — falls back to GOOGLE_API_KEY)
# Useful for quota isolation between Veo calls and other Google AI calls.
GEMINI_VEO_API_KEY=

# Nano Banana AI Image Editing (Symphony flow: face / ethnicity / clothes swap)
# Get your key at https://nanobanana.ai/dashboard
NANO_BANANA_API_KEY=nb_xxxxxxxxxxxxxxxxxxxxxxxx

# Kling AI (legacy fallback — optional)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Google Cloud Storage
GCS_BUCKET_NAME=your-video-brand-bucket
GCS_PROJECT_ID=your-gcp-project-id
# Optional: path to service account JSON (uses ADC if omitted)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# App settings
CORS_ORIGINS=https://video-generator-virid.vercel.app,http://localhost:3000
POLL_INTERVAL_SECONDS=20
